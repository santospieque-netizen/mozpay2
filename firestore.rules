rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'domingosdossantospieque@gmail.com'
      );
    }

    function existing() {
      return resource.data;
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // USER validation
    function isValidUser(data) {
      return data.keys().hasAll(['email', 'name', 'favorites', 'createdAt']) &&
        data.email is string && data.email.size() >= 0 && data.email.size() <= 256 &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
        data.favorites is list && data.favorites.size() <= 1000 &&
        data.createdAt is string && data.createdAt.size() <= 50 &&
        (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 1000)) &&
        (!('stats' in data) || (data.stats is map && data.stats.diff({}).addedKeys().hasOnly(['readingTimeMinutes', 'totalDownloads', 'readingGoal']))) &&
        (!('favoriteGenres' in data) || (data.favoriteGenres is list && data.favoriteGenres.size() <= 100));
    }

    match /admins/{userId} {
      allow read: if isOwner(userId);
    }

    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow create: if isOwner(userId) && isValidId(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidId(userId) && isValidUser(incoming()) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['favorites', 'name', 'favoriteGenres', 'photoUrl', 'stats'])
      ) &&
      incoming().email == existing().email &&
      incoming().createdAt == existing().createdAt;
    }

    // BOOKS validation
    // Allowed fields: title, author, coverUrl, pdfUrl, description, categoryId, rating, createdAt, downloads, language, schoolClass
    function isValidBook(data) {
      return data.keys().hasAll(['title', 'author', 'coverUrl', 'description', 'categoryId', 'createdAt']) &&
        data.title is string && data.title.size() <= 200 &&
        data.author is string && data.author.size() <= 100 &&
        data.coverUrl is string && data.coverUrl.size() <= 1000 &&
        data.description is string && data.description.size() <= 5000 &&
        data.categoryId is string && data.categoryId.size() <= 100 &&
        data.createdAt is string && data.createdAt.size() <= 50 &&
        ( !('pdfUrl' in data) || (data.pdfUrl is string && data.pdfUrl.size() <= 1000) ) &&
        ( !('rating' in data) || (data.rating is number) ) &&
        ( !('downloads' in data) || (data.downloads is number) ) &&
        ( !('language' in data) || (data.language is string && data.language.size() <= 100) ) &&
        ( !('schoolClass' in data) || (data.schoolClass is string && data.schoolClass.size() <= 100) ) &&
        ( !('subject' in data) || (data.subject is string && data.subject.size() <= 100) ) &&
        ( !('year' in data) || (data.year is string && data.year.size() <= 50) ) &&
        ( !('summary' in data) || (data.summary is string && data.summary.size() <= 2000) ) &&
        ( !('synopsis' in data) || (data.synopsis is string && data.synopsis.size() <= 10000) ) &&
        ( !('tags' in data) || (data.tags is list && data.tags.size() <= 50) );
    }

    match /books/{bookId} {
      allow read: if true; // Public catalog
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        incoming().diff(existing()).affectedKeys().hasOnly(['downloads']) &&
        incoming().downloads == ('downloads' in existing() ? existing().downloads : 0) + 1
      );
    }

    // READING HISTORY validation
    // Allowed fields: userId, bookId, progressPercentage, lastReadAt
    function isValidHistory(data) {
      return data.keys().hasAll(['userId', 'bookId', 'progressPercentage', 'lastReadAt']) &&
        data.size() == 4 &&
        data.userId is string && data.userId.size() <= 128 &&
        data.bookId is string && data.bookId.size() <= 128 &&
        data.progressPercentage is number &&
        data.lastReadAt is string && data.lastReadAt.size() <= 50;
    }

    match /reading_history/{historyId} {
      allow read: if isSignedIn() && existing().userId == request.auth.uid;
      allow create: if isSignedIn() && incoming().userId == request.auth.uid && isValidHistory(incoming());
      allow update: if isSignedIn() && existing().userId == request.auth.uid && incoming().userId == request.auth.uid && isValidHistory(incoming()) &&
        incoming().diff(existing()).affectedKeys().hasOnly(['userId', 'bookId', 'progressPercentage', 'lastReadAt']) &&
        incoming().bookId == existing().bookId && incoming().userId == existing().userId;
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }
  }
}
